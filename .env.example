# Copy to .env and fill in values. Never commit .env.
# If API keys were ever pasted into chat, rotate them in the bitbank console.
# Numbers here match src/bitbank_bot/config.py Master Policy constants.

BITBANK_API_KEY=
BITBANK_API_SECRET=

# true = evaluate signals and log ORDER_INTENT, never call the order API
DRY_RUN=true
# true = allow private order API (requires DRY_RUN=false)
LIVE_TRADING=false
# paper state only; still not a Bitbank fill (logged as SIMULATED_FILL)
DRY_RUN_SIMULATE_FILL=true

BITBANK_PAIR=btc_jpy
BITBANK_PUBLIC_URL=https://public.bitbank.cc
BITBANK_PRIVATE_URL=https://api.bitbank.cc/v1
BITBANK_WS_URL=wss://stream.bitbank.cc/socket.io/?EIO=4&transport=websocket

CANDLE_TYPE=1hour
MA_PERIOD=20
MA_SHORT_PERIOD=20
MA_LONG_PERIOD=50
MA_KIND=sma
MA_SLOPE_THRESHOLD=0.0005
MAX_BALANCE_USAGE=0.95
FEE_BUFFER=0.0015
LOOP_SECONDS=15
NO_TRADE_TIMEOUT_SECONDS=900
STALE_DATA_SECONDS=60
LOG_LEVEL=INFO

BITBANK_ORDER_TYPE=limit
POST_ONLY=false
ACCESS_TIME_WINDOW=5000
MAX_POSITION_BTC=1
# Halt when realized daily PnL <= -DAILY_PNL_FLOOR (JPY).
# This is a same-day buy halt, not a latched kill_switch. Resets next JST day.
DAILY_PNL_FLOOR=150
# Optional extra daily-loss cap in JPY (empty = only the floor above)
MAX_DAILY_LOSS_JPY=
# Operator hard-stop. true (or a file at KILL_SWITCH_PATH) blocks new buys.
# Removing the file unblocks; a daily-loss halt is not persisted as this flag.
KILL_SWITCH=false

# Used only when API keys are absent (paper sizing)
DRY_RUN_FREE_JPY=100000
DRY_RUN_FREE_BTC=0

HISTORY_DAYS=14
KILL_SWITCH_PATH=data/KILL
STATE_PATH=data/state.json
LOCK_PATH=data/bot.lock
LOG_DIR=logs

# Wiki-only golden/dead-cross extra rules (README R1–R8 stay the default)
WIKI_CROSS_RULES=false
# Fetch 8 timeframes for health logs; do not score-sum a new strategy
MTF_HEALTH=true
# When true, block buys if 1w/1d/4h candles are missing
MTF_FILTER=false
