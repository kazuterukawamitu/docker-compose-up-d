# Copy to .env and fill in values. Never commit .env.
# If API keys were pasted into chat, rotate them in the bitbank console.

BITBANK_API_KEY=
BITBANK_API_SECRET=

# --- Trading mode (pick ONE style) ---
# A) Explicit dual confirm (recommended for LIVE):
DRY_RUN=true
LIVE_TRADING=false
# B) Alias (when DRY_RUN / LIVE_TRADING are unset):
# TRADING_MODE=DRY_RUN
# TRADING_MODE=LIVE
#
# To go LIVE on Sakura VPS / iTerm after keys are set:
#   bash scripts/enable_live.sh
# which writes DRY_RUN=false, LIVE_TRADING=true, TRADING_MODE=LIVE
#
# MODE / BLOCK_REASON in logs:
#   MODE=DRY_RUN  LIVE_ALLOWED=False  BLOCK_REASON=dry_run
#   MODE=LIVE     LIVE_ALLOWED=True   BLOCK_REASON=

# paper ledger only; still not a Bitbank fill (logged as SIMULATED_FILL)
DRY_RUN_SIMULATE_FILL=true

BITBANK_PAIR=btc_jpy
BITBANK_PUBLIC_URL=https://public.bitbank.cc
BITBANK_PRIVATE_URL=https://api.bitbank.cc/v1
BITBANK_WS_URL=wss://stream.bitbank.cc/socket.io/?EIO=4&transport=websocket

CANDLE_TYPE=1hour
MA_PERIOD=20
MA_SHORT_PERIOD=20
MA_LONG_PERIOD=50
MA_KIND=sma
MA_SLOPE_THRESHOLD=0.0005

# Granville BUY3/BUY4 sensitivity (fraction). Lower = more buy setups.
# Defaults 1% (was 5%). Fee edge + HTF filter still gate new buys.
BUY3_EXTEND=0.01
BUY4_DIP=0.01
# BUY size uses free_amount * MAX_BALANCE_USAGE each order (realtime upper bound).
MAX_BALANCE_USAGE=0.95
FEE_BUFFER=0.0015
# Bitbank spot taker is 0.12%. Used when the fill payload has no fee fields.
TAKER_FEE_RATE=0.0012
# Live stop. 0 disables it. Take-profit still uses the BUY1–4 percents.
STOP_LOSS_PCT=0.02
ENABLE_PROTECTIVE_EXITS=true
# Unfilled live SELL limits are canceled and resent as market after this many seconds. 0 disables.
SELL_UNFILLED_SEC=20
LOOP_SECONDS=15
NO_TRADE_TIMEOUT_SECONDS=900
STALE_DATA_SECONDS=60
LOG_LEVEL=INFO

BITBANK_ORDER_TYPE=limit
POST_ONLY=false
ACCESS_TIME_WINDOW=5000
MAX_POSITION_BTC=1
# 0 = disabled. Set a positive JPY amount to halt new buys after that daily loss.
DAILY_PNL_FLOOR=0
MAX_DAILY_LOSS_JPY=
KILL_SWITCH=false
MAX_DRAWDOWN_JPY=
CIRCUIT_BREAKER_ERRORS=5

# Used only when API keys are absent (paper sizing)
DRY_RUN_FREE_JPY=100000
DRY_RUN_FREE_BTC=0

HISTORY_DAYS=14
KILL_SWITCH_PATH=data/KILL
STATE_PATH=data/state.json
LOCK_PATH=data/bot.lock
LOG_DIR=logs
ENABLE_WEBSOCKET=true
# Hard filter: block new BUY if 4h and 1d SMA both slope down, or HTF data is missing.
ENABLE_HTF_FILTER=true

# Optional Sentry — set DSN in .env, never paste `import sentry_sdk` into zsh.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Shadow/guard timers activate only while run_forever is looping (evidence-based).
# SHADOW_TIMER=yes
# GUARD_TIMER=yes
