# Copy to .env and fill in values. Never commit .env.
# If API keys were pasted into chat, rotate them in the bitbank console.

BITBANK_API_KEY=
BITBANK_API_SECRET=

# true = evaluate signals and log ORDER_INTENT, never call POST /v1/user/spot/order
DRY_RUN=true
# true = allow private order API (requires DRY_RUN=false AND keys)
LIVE_TRADING=false
# Required for LIVE. Without this exact value, DRY_RUN=false + LIVE_TRADING=true
# becomes LIVE_READY (WOULD_SUBMIT_ORDER only).
LIVE_TRADING_CONFIRM=
# dry_run | live_ready | live  (empty = derive from DRY_RUN / LIVE_TRADING)
TRADING_MODE=dry_run
# fixed | dynamic | auto
RATE_MODE=fixed
# If true, stop after the signal (never used by default)
SIGNAL_ONLY=false
# paper ledger only; still not a Bitbank fill (logged as SIMULATED_FILL)
DRY_RUN_SIMULATE_FILL=true

BITBANK_PAIR=btc_jpy
BITBANK_PUBLIC_URL=https://public.bitbank.cc
BITBANK_PRIVATE_URL=https://api.bitbank.cc/v1
BITBANK_WS_URL=wss://stream.bitbank.cc/socket.io/?EIO=4&transport=websocket

CANDLE_TYPE=1hour
MA_PERIOD=20
MA_SHORT_PERIOD=20
MA_LONG_PERIOD=50
MA_KIND=sma
MA_SLOPE_THRESHOLD=0.0005

# Recalc from Bitbank free_amount immediately before every order.
# BALANCE_USAGE_RATIO is an alias for MAX_BALANCE_USAGE.
MAX_BALANCE_USAGE=0.95
FEE_BUFFER=0.0015
LOOP_SECONDS=15
NO_TRADE_TIMEOUT_SECONDS=900
STALE_DATA_SECONDS=60
LOG_LEVEL=INFO

BITBANK_ORDER_TYPE=limit
POST_ONLY=false
ACCESS_TIME_WINDOW=5000
MAX_POSITION_BTC=1
# 0 = disabled. Set a positive JPY amount to halt new buys after that daily loss.
DAILY_PNL_FLOOR=0
MAX_DAILY_LOSS_JPY=
KILL_SWITCH=false
MAX_DRAWDOWN_JPY=
CIRCUIT_BREAKER_ERRORS=5

# Used only when API keys are absent (paper sizing)
DRY_RUN_FREE_JPY=100000
DRY_RUN_FREE_BTC=0

HISTORY_DAYS=14
KILL_SWITCH_PATH=data/KILL
STATE_PATH=data/state.json
LOCK_PATH=data/bot.lock
LOG_DIR=logs
ENABLE_WEBSOCKET=true
# Hard filter: block new BUY if 4h and 1d SMA both slope down, or HTF data is missing.
ENABLE_HTF_FILTER=true

# DYNAMIC / AUTO clamps (percent as decimals)
MIN_TP_PCT=0.01
MAX_TP_PCT=0.12
MIN_SL_PCT=0.01
MAX_SL_PCT=0.08
MIN_RISK_PCT=0.002
MAX_RISK_PCT=0.02
DEFAULT_SL_PCT=0.02
DEFAULT_RISK_PCT=0.005
ATR_PERIOD=14
ADX_PERIOD=14
REGIME_ATR_HIGH=0.03
REGIME_ADX_TREND=25
REGIME_ADX_RANGE=18
HIGH_VOL_POSITION_SCALE=0.5
RANGE_SUPPRESS_BUYS=false
STALE_PRICE_PCT=0.02
COOLDOWN_SECONDS=0
RECONCILE_EVERY_CYCLES=20
# Optional. Never commit a real DSN with secrets in query string if any.
SENTRY_DSN=
