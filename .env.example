# Copy to .env and fill in locally. Never commit .env or real keys.

# Bitbank REST credentials (required only when DRY_RUN=false)
BITBANK_API_KEY=
BITBANK_API_SECRET=

# Trading pair is fixed to Bitbank spot BTC/JPY.
PAIR=btc_jpy

# true (default): fetch public data, log intended orders, never place live orders.
# false: live trading. Requires API keys and an explicit opt-in.
DRY_RUN=true

# Candle and indicator settings
CANDLE_TYPE=5min
LOOP_SECONDS=30
MA_PERIOD=20
MA_TYPE=sma
FAST_MA=20
SLOW_MA=50
TREND_LOOKBACK=5
TREND_THRESHOLD=0.001

# Order type: limit (default) or market
ORDER_TYPE=limit

# Fees / safety used when sizing "possible amount"
TAKER_FEE_RATE=0.0012
SAFETY_MARGIN=0.002

# Risk limits (fractions, e.g. 0.03 = 3%)
MAX_POSITION_BTC=0.05
MAX_LOSS_FRACTION=0.05
STOP_LOSS_PCT=0.03
TRAILING_STOP_PCT=0.02
TAKE_PROFIT_CAP_PCT=0.10
COMPOUNDING=true

# Strategies: comma-separated. granville = README MA rules (primary).
STRATEGIES=granville

# Optional ML overlay (disabled unless a model file exists)
ML_ENABLED=false
ML_MODEL_PATH=

# Paths
LOG_DIR=logs
DATA_DIR=data
LOCK_FILE=data/bitbank_bot.lock
DASHBOARD=true
LOG_LEVEL=INFO
