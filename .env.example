# Copy to .env and fill in locally. Never commit .env or real keys.
# Default is dry-run: the bot evaluates signals and simulates fills, and does not POST live orders.

DRY_RUN=true
BITBANK_API_KEY=
BITBANK_API_SECRET=

# Spot pair (Bitbank API form)
PAIR=btc_jpy

# Primary candle type for the README moving-average rules
CANDLE_TYPE=5min
MA_KIND=ema
MA_PERIOD=20
EMA_FAST=20
EMA_SLOW=50
SLOPE_LOOKBACK=3
FLAT_THRESHOLD=0.0005

# min_unit = 0.0001 BTC (safer default). max_available = README「可能量」.
ORDER_SIZE_MODE=min_unit
MIN_BTC=0.0001
BALANCE_USAGE_RATIO=0.99
MAX_POSITION_BTC=0.01
MAX_DAILY_LOSS_JPY=50000
MAX_LOSS_JPY=100000

# limit uses best bid/ask. market is blocked when Bitbank circuit-break mode is not NONE.
ORDER_TYPE=limit
STALE_MS=15000
LOOP_SECONDS=5
LOG_LEVEL=INFO
LOG_DIR=logs
STATE_DIR=state
KILL_SWITCH=false
DASHBOARD=true
