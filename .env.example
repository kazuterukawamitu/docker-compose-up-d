# Copy to .env and fill in values. Never commit .env.
# If API keys were ever pasted into chat, rotate them in the bitbank console.

BITBANK_API_KEY=
BITBANK_API_SECRET=

# true = evaluate signals and log ORDER_INTENT, never call the order API
DRY_RUN=true
# true = allow private order API (requires DRY_RUN=false)
LIVE_TRADING=false

BITBANK_PAIR=btc_jpy
CANDLE_TYPE=1hour
MA_PERIOD=20
MA_SHORT_PERIOD=20
MA_LONG_PERIOD=50
MA_KIND=sma
MA_SLOPE_THRESHOLD=0.0005
MAX_BALANCE_USAGE=0.95
FEE_BUFFER=0.0015
LOOP_SECONDS=15
NO_TRADE_TIMEOUT_SECONDS=900
STALE_DATA_SECONDS=60
LOG_LEVEL=INFO

BITBANK_ORDER_TYPE=limit
POST_ONLY=false
ACCESS_TIME_WINDOW=5000
MAX_POSITION_BTC=1
# Halt when realized daily PnL <= -DAILY_PNL_FLOOR (JPY). Includes the 150 JPY liquidation floor.
DAILY_PNL_FLOOR=150
# Optional extra daily-loss cap in JPY (empty = only the floor above)
MAX_DAILY_LOSS_JPY=

# Used only when API keys are absent (paper sizing)
DRY_RUN_FREE_JPY=100000
DRY_RUN_FREE_BTC=0

HISTORY_DAYS=14
KILL_SWITCH_PATH=data/KILL
STATE_PATH=data/state.json
LOCK_PATH=logs/bitbank_bot.lock
LOG_DIR=logs
# RNG_SEED is for tests/backtests only — never used for live order sizes
# RNG_SEED=42
