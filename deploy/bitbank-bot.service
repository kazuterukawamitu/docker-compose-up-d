[Unit]
Description=Bitbank BTC/JPY MA spot bot (DRY_RUN by default)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bitbank-bot
EnvironmentFile=/opt/bitbank-bot/.env
Environment=PYTHONPATH=/opt/bitbank-bot/src
ExecStart=/opt/bitbank-bot/.venv/bin/python -m bitbank_bot
Restart=always
RestartSec=10
# Example unit only. Do not enable on this Cloud Agent VM.
# Engine-only start: systemd Restart=always covers crashes.
# Do not also use start.sh --supervise here (that would nest restart loops).
# For a supervised shell start instead: ExecStart=/opt/bitbank-bot/start.sh --no-screen --no-supervise
# Copy to the VPS and keep TRADING_MODE=DRY_RUN unless dual-auth LIVE is set in .env.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
