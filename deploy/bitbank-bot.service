[Unit]
Description=Bitbank BTC/JPY MA spot bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bitbank-bot
EnvironmentFile=/opt/bitbank-bot/.env
Environment=PYTHONPATH=/opt/bitbank-bot/src
ExecStart=/opt/bitbank-bot/.venv/bin/python -m bitbank_bot
Restart=on-failure
RestartSec=10
# DRY_RUN=true unless LIVE_TRADING is explicitly enabled in EnvironmentFile
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
