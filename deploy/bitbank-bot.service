[Unit]
Description=Bitbank BTC/JPY MA spot bot (DRY_RUN by default)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bitbank-bot
EnvironmentFile=/opt/bitbank-bot/.env
Environment=PYTHONPATH=/opt/bitbank-bot/src
ExecStart=/opt/bitbank-bot/.venv/bin/python -m bitbank_bot
Restart=always
RestartSec=10
# Example unit only. Do not enable on this Cloud Agent VM.
# Copy to the VPS. Keep DRY_RUN=true unless LIVE_TRADING and
# LIVE_TRADING_CONFIRM=YES_I_ACCEPT_REAL_MONEY_RISK are set in .env.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
