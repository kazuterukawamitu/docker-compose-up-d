FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    DRY_RUN=true \
    LIVE_TRADING=false \
    AUDIT_REPORT_DIR=/tmp/bitbank-audit \
    AUDIT_LOOP_SEC=30 \
    AUDIT_HEALTH_MAX_AGE=180

WORKDIR /app

COPY requirements.txt requirements-dev.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements-dev.txt \
    && pip install --no-cache-dir ruff

COPY src ./src
COPY tests ./tests
COPY docker ./docker
COPY scripts ./scripts
COPY main.py run.py diagnostics.py ./

RUN mkdir -p /tmp/bitbank-audit /app/logs /app/data \
    && useradd --create-home --uid 10001 audit \
    && chown -R audit:audit /app /tmp/bitbank-audit
USER audit

CMD ["python3", "/app/docker/audit_agent.py"]
