# Copy to .env for LIVE orders:  cp live.env.example .env
# Fill keys locally. Never commit .env. Never paste keys into chat.
# If keys were pasted into chat, rotate them in the bitbank console.

BITBANK_API_KEY=
BITBANK_API_SECRET=

# Both required to call POST /v1/user/spot/order
DRY_RUN=false
LIVE_TRADING=true

BITBANK_PAIR=btc_jpy
BITBANK_ORDER_TYPE=limit
POST_ONLY=false
MAX_BALANCE_USAGE=0.95
MIN_AMOUNT_BTC=0.0001
MAX_POSITION_BTC=1
ENABLE_HTF_FILTER=true
ENABLE_WEBSOCKET=true
LOOP_SECONDS=15
NO_TRADE_TIMEOUT_SECONDS=900
KILL_SWITCH=false
KILL_SWITCH_PATH=data/KILL
STATE_PATH=data/state.json
LOCK_PATH=data/bot.lock
LOG_DIR=logs
